---
import { getCollection, render } from 'astro:content';
import Zaklad from '../layouts/Zaklad.astro';
import Blob from '../components/Blob.astro';

const [tabor] = await getCollection('tabor');

if (!tabor) {
  throw new Error('Chybí obsah stránky tábora v src/content/stranky/tabor.md');
}

const { Content } = await render(tabor);
const {
  nazev,
  metaPopis,
  znacka,
  perex,
  datumOd,
  datumDo,
  datumText,
  vek,
  cena,
  cenaCiselne,
  kapacita,
  odkazFormular,
  prihlaseniAktivni,
  upozorneni,
  hlavniObrazek,
  hlavniObrazekAlt,
  fotky = [],
} = tabor.data;

const siteUrl = import.meta.env.PUBLIC_SITE_URL ?? 'https://zahalka.cz';
const datumOdISO = datumOd.toISOString().split('T')[0];
const datumDoISO = datumDo.toISOString().split('T')[0];
const lzeSePrihlasit = prihlaseniAktivni && Boolean(odkazFormular);

const campSchema = {
  '@context': 'https://schema.org',
  '@type': 'Event',
  name: nazev,
  startDate: datumOdISO,
  endDate: datumDoISO,
  eventStatus: 'https://schema.org/EventScheduled',
  eventAttendanceMode: 'https://schema.org/OfflineEventAttendanceMode',
  description: metaPopis,
  url: `${siteUrl}/tabor`,
  image: hlavniObrazek ? `${siteUrl}${hlavniObrazek}` : `${siteUrl}/og-default.png`,
  organizer: {
    '@type': 'Organization',
    name: 'Zahálka',
    url: siteUrl,
  },
  location: {
    '@type': 'Place',
    name: 'Zahálka – kulturní prostor',
    address: {
      '@type': 'PostalAddress',
      streetAddress: 'Benešovo nám. 3282',
      addressLocality: 'Teplice',
      postalCode: '415 01',
      addressCountry: 'CZ',
    },
  },
  offers: {
    '@type': 'Offer',
    price: cenaCiselne?.toString(),
    priceCurrency: 'CZK',
    availability: lzeSePrihlasit
      ? 'https://schema.org/InStock'
      : 'https://schema.org/SoldOut',
    ...(odkazFormular ? { url: odkazFormular } : {}),
  },
};
---

<Zaklad
  title={`${nazev} – Zahálka Teplice`}
  description={metaPopis}
  ogImage={hlavniObrazek}
  ogType="event"
  canonicalPath="/tabor"
>
  <Fragment slot="head">
    <script type="application/ld+json" set:html={JSON.stringify(campSchema)} />
  </Fragment>

  <main>
    <section class="hero" aria-label="O táboře">
      <Blob color="limetka" position="top-right" size={500} opacity={0.65} />
      <Blob color="oranzova" position="bottom-left" size={400} opacity={0.55} />

      <header class="hero-obsah">
        <p class="znacka">{znacka}</p>
        <h1>{nazev}</h1>
        <p class="hero-perex">{perex} Pro děti {vek}.</p>

        <dl class="klic-fakta">
          <div class="fakt">
            <dt>Kdy</dt>
            <dd><time datetime={datumOdISO}>{datumText}</time></dd>
          </div>
          <div class="fakt">
            <dt>Věk</dt>
            <dd>{vek}</dd>
          </div>
          <div class="fakt">
            <dt>Cena</dt>
            <dd>{cena}</dd>
          </div>
          <div class="fakt">
            <dt>Kapacita</dt>
            <dd>{kapacita}</dd>
          </div>
        </dl>

        {lzeSePrihlasit && (
          <a
            href={odkazFormular}
            target="_blank"
            rel="noopener"
            class="btn-prihlasit"
            data-event="prihlaseni"
            data-akce={nazev}
          >
            Přihlásit dítě →
          </a>
        )}
        {upozorneni && <p class="hero-upozorneni">{upozorneni}</p>}
      </header>
    </section>

    {hlavniObrazek && (
      <figure class="hlavni-fotka">
        <img
          src={hlavniObrazek}
          alt={hlavniObrazekAlt ?? ''}
          width="1200"
          height="800"
          loading="eager"
        />
      </figure>
    )}

    <article class="obsah">
      <Content />
    </article>

    {fotky.length > 0 && (
      <section class="fotogalerie" aria-labelledby="fotogalerie-tabor">
        <h2 id="fotogalerie-tabor">Fotogalerie</h2>
        <ul>
          {fotky.map((fotka) => (
            <li>
              <figure>
                <img
                  src={fotka.obrazek}
                  alt={fotka.altText}
                  width="1200"
                  height="800"
                  loading="lazy"
                />
                {fotka.popisek && <figcaption>{fotka.popisek}</figcaption>}
              </figure>
            </li>
          ))}
        </ul>
      </section>
    )}

    {lzeSePrihlasit && (
      <section class="sekce-cta" aria-labelledby="cta-nadpis" id="prihlasit-se">
        <h2 id="cta-nadpis">Chcete místo pro vaše dítě?</h2>
        <p>Přihlášení probíhá přes online formulář. Kapacita je omezená.</p>
        <a
          href={odkazFormular}
          target="_blank"
          rel="noopener"
          class="btn-prihlasit btn-prihlasit-cta"
          data-event="prihlaseni"
          data-akce={nazev}
        >
          Přihlásit dítě →
        </a>
        <p class="cta-kontakt">
          Dotazy? Pište na <a href="mailto:zahalkateplice@gmail.com">zahalkateplice@gmail.com</a>
        </p>
      </section>
    )}
  </main>
</Zaklad>

<style>
  .hero {
    position: relative;
    overflow: hidden;
    min-height: 70vh;
    display: flex;
    align-items: center;
    padding: 5rem 2rem;
  }

  .hero-obsah {
    position: relative;
    z-index: 1;
    width: min(700px, 100%);
    margin-inline: auto;
  }

  .znacka {
    font-family: var(--pismo-nadpisy);
    font-size: 0.7rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.14em;
    opacity: 0.5;
    margin-bottom: 0.75rem;
  }

  h1 {
    font-size: clamp(2.5rem, 7vw, 5rem);
    line-height: 1;
    margin-bottom: 1rem;
  }

  .hero-perex {
    font-size: 1.15rem;
    line-height: 1.65;
    max-width: 52ch;
    opacity: 0.85;
    margin-bottom: 2rem;
  }

  .klic-fakta {
    display: flex;
    flex-wrap: wrap;
    margin-bottom: 2.25rem;
    border-block: 1px solid color-mix(in srgb, var(--barva-text) 20%, transparent);
  }

  .fakt {
    flex: 1 1 auto;
    min-width: 120px;
    padding: 0.9rem 1rem;
    border-right: 1px solid color-mix(in srgb, var(--barva-text) 15%, transparent);
  }

  .fakt:last-child {
    border-right: none;
  }

  .klic-fakta dt {
    font-family: var(--pismo-nadpisy);
    font-size: 0.6rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.12em;
    opacity: 0.45;
    margin-bottom: 0.2rem;
  }

  .klic-fakta dd {
    font-size: 1rem;
    font-weight: 500;
  }

  .btn-prihlasit {
    display: inline-block;
    background-color: var(--barva-text);
    color: var(--barva-pozadi);
    text-decoration: none;
    padding: 1rem 2.25rem;
    border-radius: 100vw;
    font-family: var(--pismo-nadpisy);
    font-size: 0.9rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.08em;
  }

  .btn-prihlasit:hover,
  .btn-prihlasit:focus-visible {
    background-color: var(--barva-text-d);
    color: var(--barva-pozadi);
  }

  .hero-upozorneni {
    font-size: 0.82rem;
    opacity: 0.65;
    margin-top: 0.75rem;
  }

  .hlavni-fotka,
  .obsah,
  .fotogalerie {
    width: min(820px, calc(100% - 4rem));
    margin-inline: auto;
  }

  .hlavni-fotka {
    margin-block: 3rem 0;
    border-radius: 1rem;
    overflow: hidden;
  }

  .hlavni-fotka img,
  .fotogalerie img {
    width: 100%;
    height: auto;
    aspect-ratio: 3 / 2;
    object-fit: cover;
    display: block;
  }

  .obsah {
    padding-block: 4rem 5rem;
  }

  .obsah :global(h2) {
    font-size: clamp(1.1rem, 2.5vw, 1.4rem);
    margin: 3.75rem 0 1.25rem;
  }

  .obsah :global(h2:first-child) {
    margin-top: 0;
  }

  .obsah :global(h3) {
    font-size: 0.95rem;
    margin: 2rem 0 0.5rem;
  }

  .obsah :global(p),
  .obsah :global(li) {
    line-height: 1.7;
  }

  .obsah :global(p),
  .obsah :global(ul) {
    margin-bottom: 1.25rem;
  }

  .obsah :global(ul) {
    padding-left: 1.4rem;
  }

  .obsah :global(a) {
    text-decoration: underline;
    text-underline-offset: 3px;
  }

  .obsah :global(table) {
    width: 100%;
    border-collapse: collapse;
    margin-block: 1.5rem 2rem;
    font-size: 0.95rem;
  }

  .obsah :global(th),
  .obsah :global(td) {
    text-align: left;
    vertical-align: top;
    padding: 0.75rem;
    border-bottom: 1px solid color-mix(in srgb, var(--barva-text) 12%, transparent);
  }

  .fotogalerie {
    padding-bottom: 5rem;
  }

  .fotogalerie h2 {
    font-size: 1.2rem;
    margin-bottom: 1.25rem;
  }

  .fotogalerie ul {
    list-style: none;
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(240px, 1fr));
    gap: 1.25rem;
  }

  .fotogalerie figure {
    overflow: hidden;
    border-radius: 0.75rem;
    background: color-mix(in srgb, var(--barva-text) 7%, var(--barva-pozadi));
  }

  .fotogalerie figcaption {
    padding: 0.65rem 0.8rem;
    font-size: 0.85rem;
    opacity: 0.7;
  }

  .sekce-cta {
    background-color: var(--barva-text);
    color: var(--barva-pozadi);
    padding: 5rem 2rem 6rem;
    text-align: center;
  }

  .sekce-cta h2 {
    font-size: clamp(1.25rem, 3vw, 2rem);
    margin-bottom: 0.75rem;
  }

  .sekce-cta p {
    max-width: 46ch;
    margin: 0 auto 2rem;
    color: inherit;
    opacity: 0.8;
  }

  .btn-prihlasit-cta {
    background-color: var(--barva-pozadi);
    color: var(--barva-text);
  }

  .cta-kontakt {
    margin-top: 1.5rem !important;
    font-size: 0.88rem;
  }

  .cta-kontakt a {
    color: inherit;
  }

  @media (max-width: 600px) {
    .hero {
      min-height: unset;
      padding-block: 3.5rem 4rem;
    }

    .klic-fakta {
      flex-direction: column;
    }

    .fakt {
      border-right: none;
      border-bottom: 1px solid color-mix(in srgb, var(--barva-text) 12%, transparent);
      padding-inline: 0;
    }

    .fakt:last-child {
      border-bottom: none;
    }

    .obsah :global(table) {
      font-size: 0.82rem;
    }

    .obsah :global(th),
    .obsah :global(td) {
      padding-inline: 0.35rem;
    }
  }
</style>
