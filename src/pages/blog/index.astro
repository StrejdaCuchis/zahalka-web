---
import { getCollection } from 'astro:content';
import Zaklad from '../../layouts/Zaklad.astro';
import KartaClanku from '../../components/KartaClanku.astro';
import Newsletter from '../../components/Newsletter.astro';
import Blob from '../../components/Blob.astro';

const clanky = (await getCollection('blog'))
  .filter((clanek) => clanek.data.publikovano)
  .sort((a, b) => b.data.datumPublikace.getTime() - a.data.datumPublikace.getTime());
---

<Zaklad
  title="Blog – Zahálka"
  description="Příběhy, inspirace a témata ze Zahálky — kultura, tvoření, děti a život v Teplicích."
  canonicalPath="/blog"
>
  <main>
    <Blob color="fialova" position="top-right" size={430} opacity={0.56} />
    <Blob color="salvej" position="bottom-left" size={380} opacity={0.42} />

    <header class="uvod">
      <p class="znacka">Čtení ze Zahálky</p>
      <h1>Blog</h1>
      <p>
        Píšeme o tvoření, kultuře, dětech a městě kolem nás. O tom, co se děje v Zahálce,
        i o tématech, která s námi zůstávají po skončení akcí.
      </p>
    </header>

    {clanky.length > 0 ? (
      <section class="clanky" aria-label="Všechny články">
        {clanky.map((clanek) => <KartaClanku entry={clanek} />)}
      </section>
    ) : (
      <p class="prazdny-blog">První články právě připravujeme.</p>
    )}

    <aside aria-label="Odběr newsletteru">
      <Newsletter />
    </aside>
  </main>
</Zaklad>

<style>
  main {
    position: relative;
    overflow: hidden;
    padding: 4rem 2rem 5rem;
  }

  .uvod,
  .clanky,
  aside,
  .prazdny-blog {
    position: relative;
    z-index: 1;
    max-width: 1100px;
    margin-inline: auto;
  }

  .uvod {
    margin-bottom: 3rem;
  }

  .znacka {
    margin-bottom: 0.55rem;
    font-family: var(--pismo-nadpisy);
    font-size: 0.72rem;
    font-weight: 600;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    opacity: 0.55;
  }

  h1 {
    margin-bottom: 1rem;
    font-size: clamp(2.25rem, 6vw, 4rem);
  }

  .uvod > p:last-child {
    max-width: 62ch;
    font-size: 1.08rem;
    line-height: 1.7;
    opacity: 0.84;
  }

  .clanky {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(280px, 1fr));
    gap: 1.5rem;
  }

  aside {
    margin-top: 4rem;
  }

  .prazdny-blog {
    opacity: 0.7;
  }

  @media (max-width: 520px) {
    main {
      padding-inline: 1.25rem;
    }
  }
</style>
