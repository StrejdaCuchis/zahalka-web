---
import { getCollection } from 'astro:content';
import Zaklad from '../layouts/Zaklad.astro';
import KartaAkce from '../components/KartaAkce.astro';
import KartaClanku from '../components/KartaClanku.astro';
import Newsletter from '../components/Newsletter.astro';
import { schemaOrganizace } from '../data/kontakty';
const vsechnyAkce = await getCollection('akce');
const vsechnyClanky = await getCollection('blog');

const siteUrl = import.meta.env.PUBLIC_SITE_URL ?? 'https://zahalka.cz';

const organizationSchema = schemaOrganizace(siteUrl);

const dnes = new Date();
dnes.setHours(0, 0, 0, 0);

const nejblizsiAkce = vsechnyAkce
  .filter((a) => a.data.datum >= dnes)
  .sort((a, b) => a.data.datum.getTime() - b.data.datum.getTime())
  .slice(0, 3);

const nejnovejsiClanky = vsechnyClanky
  .filter((clanek) => clanek.data.publikovano)
  .sort((a, b) => b.data.datumPublikace.getTime() - a.data.datumPublikace.getTime())
  .slice(0, 3);
---

<Zaklad
  pozadi={1}
  scena
  title="Zahálka – kulturní prostor Teplice"
  description="Zahálka je kulturní prostor v Teplicích pro besedy, workshopy a festivaly. Přijďte na akci — dveře otevíráme pro každého."
  canonicalPath="/"
>
  <Fragment slot="head">
    <script type="application/ld+json" set:html={JSON.stringify(organizationSchema)} />
  </Fragment>

  <main>
    <section class="hero" aria-label="Úvod">

      <div class="hero-obsah">
        <div class="hero-text-blok">
          <h1>
            <span class="znacka-prvni">ZAHÁLKA</span>{' '}
            <span class="znacka-spojeni">• KULTURNÍ</span>{' '}
            <span>PROSTOR</span>
          </h1>
          <p class="hero-hashtagy">
            <span>#zahalkaspresahem</span>
            <span>#kulturajinak</span>
            <span>#ohybamevyznamy</span>
            <span>#caszahalet</span>
          </p>
          <p class="hero-text">
            Podporujeme a tvoříme kulturu, umění a komunitní život v Teplicích.
          </p>
          <nav class="hero-akce" aria-label="Hlavní odkazy">
            <a href="/program" class="btn-cta">Prohlédnout program</a>
            <a href="/newsletter" class="btn-cta btn-newsletter">Odebírat newsletter</a>
          </nav>
        </div>

        <img
          src="/ilustrace/web/novy-kabat-web.webp"
          alt=""
          class="hero-ilustrace"
          width="283"
          height="400"
          loading="eager"
          aria-hidden="true"
        />
      </div>
    </section>

    {nejblizsiAkce.length > 0 && (
      <section class="nejblizsi" aria-label="Nejbližší akce">
        <div class="obal">
          <h2>Nejbližší akce</h2>
          <div class="mrizka">
            {nejblizsiAkce.map((akce) => (
              <KartaAkce entry={akce} />
            ))}
          </div>
          <div class="vice-link">
            <a href="/program">Zobrazit celý program →</a>
          </div>
        </div>
      </section>
    )}

    {nejblizsiAkce.length === 0 && (
      <section class="zadne-akce-hero">
        <p>
          Momentálně neplánujeme nové akce. Sledujte nás na{' '}
          <a href="https://www.instagram.com/zahalkateplice/" target="_blank" rel="noopener">Instagramu</a>.
        </p>
      </section>
    )}

    {nejnovejsiClanky.length > 0 && (
      <section class="blog-vyber" aria-labelledby="blog-vyber-nadpis">
        <div class="obal">
          <h2 id="blog-vyber-nadpis">Čtení ze Zahálky</h2>
          <div class="mrizka">
            {nejnovejsiClanky.map((clanek) => (
              <KartaClanku entry={clanek} urovenNadpisu={3} />
            ))}
          </div>
          <p class="vice-link"><a href="/blog">Všechny články →</a></p>
        </div>
      </section>
    )}

    <aside class="newsletter-sekce" aria-label="Odběr newsletteru">
      <Newsletter />
    </aside>

  </main>
</Zaklad>

<style>
  .hero {
    position: relative;
    overflow: hidden;
    padding: 4rem 2rem 0;
    display: flex;
    align-items: center;
    min-height: 60vh;
  }

  .hero-obsah {
    position: relative;
    z-index: 1;
    max-width: 760px;
    margin-inline: auto;
    width: 100%;
    display: grid;
    grid-template-columns: 1fr minmax(160px, 220px);
    align-items: end;
    gap: 2.5rem;
  }

  .hero-text-blok {
    position: relative;
    padding-bottom: 4rem;
  }

  .hero-ilustrace {
    position: relative;
    display: block;
    width: 100%;
    height: auto;
    align-self: end;
    margin-bottom: 3rem;
    transform: translateX(clamp(-90px, -7vw, -60px));
    pointer-events: none;
  }

  @media (max-width: 700px) {
    .hero-obsah {
      grid-template-columns: 1fr;
    }

    .hero-text-blok {
      padding-bottom: 2rem;
    }

    .hero-ilustrace {
      display: none;
    }
  }

  h1 {
    max-width: 12ch;
    font-size: clamp(2rem, 5.4vw, 3.9rem);
    margin-bottom: 1.25rem;
    text-wrap: balance;
  }

  .znacka-spojeni {
    white-space: nowrap;
  }

  .hero-hashtagy {
    display: flex;
    flex-wrap: wrap;
    gap: 0.2rem 0.65rem;
    font-family: var(--pismo-nadpisy);
    font-size: clamp(0.65rem, 1.2vw, 0.75rem);
    font-weight: 600;
    letter-spacing: 0.035em;
    margin-bottom: 1.5rem;
  }

  .hero-hashtagy span {
    white-space: nowrap;
  }

  .hero-text {
    font-size: 1.05rem;
    line-height: 1.7;
    max-width: 52ch;
    margin-bottom: 2rem;
  }

  .btn-cta {
    display: inline-block;
    width: 100%;
    border: 1.5px solid transparent;
    background-color: var(--barva-text);
    color: var(--barva-pozadi);
    text-decoration: none;
    padding: 0.8rem 2rem;
    border-radius: 100vw;
    font-family: var(--pismo-nadpisy);
    font-size: 0.8rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    text-align: center;
    transition: background-color 0.15s;
  }

  .hero-akce {
    /* Na telefonu se k tlačítkům zarovná korálový tvar scény. */
    anchor-name: --kotva-sceny;
    display: grid;
    width: max-content;
    max-width: 100%;
    gap: 0.7rem;
  }

  .btn-cta:hover {
    background-color: var(--barva-text-d);
    color: var(--barva-pozadi);
  }

  .btn-newsletter {
    border-color: var(--barva-text);
    background-color: var(--barva-pozadi);
    color: var(--barva-text);
  }

  .btn-newsletter:hover,
  .btn-newsletter:focus-visible {
    background-color: color-mix(in srgb, var(--barva-text) 8%, var(--barva-pozadi));
    color: var(--barva-text-d);
  }

  /* ── Sections below hero ─────────────────────────────── */

  .obal {
    position: relative;
    z-index: 1;
    max-width: 1100px;
    margin-inline: auto;
    padding-inline: 2rem;
  }

  .nejblizsi {
    position: relative;
    overflow: hidden;
    padding-block: 2rem 5rem;
  }

  .blog-vyber {
    position: relative;
    padding-block: 4rem;
  }

  h2 {
    font-size: 0.75rem;
    letter-spacing: 0.14em;
    margin-bottom: 1.5rem;
  }

  .mrizka {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(280px, 1fr));
    gap: 1.5rem;
  }

  .vice-link {
    margin-top: 2rem;
    text-align: right;
  }

  .vice-link a {
    font-family: var(--pismo-nadpisy);
    font-size: 0.78rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    text-decoration: none;
    transition: opacity 0.15s;
  }

  .vice-link a:hover {
    opacity: 1;
  }

  .zadne-akce-hero {
    padding: 2rem;
    text-align: center;
  }

  .newsletter-sekce {
    max-width: 1100px;
    margin: 0 auto;
    padding: 4rem 2rem 5rem;
  }

  @media (max-width: 520px) {
    .znacka-prvni {
      display: block;
    }
  }

</style>
