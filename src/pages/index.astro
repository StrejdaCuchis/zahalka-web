---
import { getCollection } from 'astro:content';
import Zaklad from '../layouts/Zaklad.astro';
import KartaAkce from '../components/KartaAkce.astro';
import Blob from '../components/Blob.astro';
const vsechnyAkce = await getCollection('akce');

const siteUrl = import.meta.env.PUBLIC_SITE_URL ?? 'https://zahalka.cz';

const organizationSchema = {
  '@context': 'https://schema.org',
  '@type': 'Organization',
  name: 'Zahálka',
  url: siteUrl,
  address: {
    '@type': 'PostalAddress',
    streetAddress: 'Benešovo nám. 3282',
    addressLocality: 'Teplice',
    postalCode: '415 01',
    addressCountry: 'CZ',
  },
  sameAs: [
    'https://www.instagram.com/zahalkateplice/',
    'https://www.facebook.com/zahalkateplice',
  ],
};

const dnes = new Date();
dnes.setHours(0, 0, 0, 0);

const nejblizsiAkce = vsechnyAkce
  .filter((a) => a.data.datum >= dnes)
  .sort((a, b) => a.data.datum.getTime() - b.data.datum.getTime())
  .slice(0, 3);
---

<Zaklad
  title="Zahálka – kulturní prostor Teplice"
  description="Zahálka je kulturní prostor v Teplicích pro besedy, workshopy a festivaly. Přijďte na akci — dveře otevíráme pro každého."
  canonicalPath="/"
>
  <Fragment slot="head">
    <script type="application/ld+json" set:html={JSON.stringify(organizationSchema)} />
  </Fragment>

  <main>
    <section class="hero" aria-label="Úvod">
      <!-- Blobs: decorative, aria-hidden, behind content via z-index -->
      <Blob color="levandule" position="top-left"  size={580} opacity={0.84} />
      <Blob color="oranzova"  position="top-right" size={400} opacity={0.78} bleed={0.5} />

      <div class="hero-obsah">
        <!-- Anchored to the illustration's corner, not the full section, so it stays
             a companion to the figure at every viewport width instead of drifting
             into the top-right blob. Hidden together with the illustration on mobile. -->
        <div class="hero-blob-ilustrace">
          <Blob color="fialova" position="bottom-right" size={320} opacity={0.76} bleed={0} />
        </div>

        <div class="hero-text-blok">
          <h1>Zahálka</h1>
          <p class="hero-podtitul">Kulturní&nbsp;prostor, Teplice</p>
          <p class="hero-text">
            Jsme prostor v centru Teplic, kde se potkávají lidé na besedách,
            workshopech a festivalech. Otvíráme dveře na každou akci — přijďte,
            jak jste.
          </p>
          <a href="/program" class="btn-cta">Prohlédnout program</a>
        </div>

        <img
          src="/ilustrace/web/novy-kabat-web.webp"
          alt=""
          class="hero-ilustrace"
          width="283"
          height="400"
          loading="eager"
          aria-hidden="true"
        />
      </div>
    </section>

    {nejblizsiAkce.length > 0 && (
      <section class="nejblizsi" aria-label="Nejbližší akce">
        <Blob color="salvej" position="bottom-left" size={380} opacity={0.48} />
        <div class="obal">
          <h2>Nejbližší akce</h2>
          <div class="mrizka">
            {nejblizsiAkce.map((akce) => (
              <KartaAkce entry={akce} />
            ))}
          </div>
          <div class="vice-link">
            <a href="/program">Zobrazit celý program →</a>
          </div>
        </div>
      </section>
    )}

    {nejblizsiAkce.length === 0 && (
      <section class="zadne-akce-hero">
        <p>
          Momentálně neplánujeme nové akce. Sledujte nás na{' '}
          <a href="https://www.instagram.com/zahalkateplice/" target="_blank" rel="noopener">Instagramu</a>.
        </p>
      </section>
    )}

    <section class="adresa-socky" aria-label="Kde nás najdete">
      <div class="obal">
        <p>
          Benešovo nám. 3282, Teplice &nbsp;·&nbsp;
          <a href="https://www.instagram.com/zahalkateplice/" target="_blank" rel="noopener">@zahalkateplice</a>
        </p>
      </div>
    </section>
  </main>
</Zaklad>

<style>
  .hero {
    position: relative;
    overflow: hidden;
    padding: 4rem 2rem 0;
    display: flex;
    align-items: center;
    min-height: 60vh;
  }

  .hero-obsah {
    position: relative;
    z-index: 1;
    max-width: 760px;
    margin-inline: auto;
    width: 100%;
    display: grid;
    grid-template-columns: 1fr minmax(160px, 220px);
    align-items: end;
    gap: 2.5rem;
  }

  .hero-text-blok {
    position: relative;
    padding-bottom: 4rem;
  }

  .hero-ilustrace {
    position: relative;
    display: block;
    width: 100%;
    height: auto;
    align-self: end;
    margin-bottom: 3rem;
    pointer-events: none;
  }

  .hero-blob-ilustrace {
    position: absolute;
    inset: 0;
    pointer-events: none;
  }

  @media (max-width: 700px) {
    .hero-obsah {
      grid-template-columns: 1fr;
    }

    .hero-text-blok {
      padding-bottom: 2rem;
    }

    .hero-ilustrace,
    .hero-blob-ilustrace {
      display: none;
    }
  }

  h1 {
    font-size: clamp(2.5rem, 7vw, 5rem);
    margin-bottom: 1rem;
  }

  .hero-podtitul {
    font-family: var(--pismo-nadpisy);
    font-size: 0.75rem;
    font-weight: 600;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    opacity: 0.5;
    margin-bottom: 1.5rem;
  }

  .hero-text {
    font-size: 1.05rem;
    line-height: 1.7;
    max-width: 52ch;
    opacity: 0.85;
    margin-bottom: 2rem;
  }

  .btn-cta {
    display: inline-block;
    background-color: var(--barva-text);
    color: var(--barva-pozadi);
    text-decoration: none;
    padding: 0.8rem 2rem;
    border-radius: 100vw;
    font-family: var(--pismo-nadpisy);
    font-size: 0.8rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    transition: background-color 0.15s;
  }

  .btn-cta:hover {
    background-color: var(--barva-text-d);
    color: var(--barva-pozadi);
  }

  /* ── Sections below hero ─────────────────────────────── */

  .obal {
    position: relative;
    z-index: 1;
    max-width: 1100px;
    margin-inline: auto;
    padding-inline: 2rem;
  }

  .nejblizsi {
    position: relative;
    overflow: hidden;
    padding-block: 2rem 5rem;
  }

  h2 {
    font-size: 0.75rem;
    letter-spacing: 0.14em;
    opacity: 0.5;
    margin-bottom: 1.5rem;
  }

  .mrizka {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(280px, 1fr));
    gap: 1.5rem;
  }

  .vice-link {
    margin-top: 2rem;
    text-align: right;
  }

  .vice-link a {
    font-family: var(--pismo-nadpisy);
    font-size: 0.78rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    text-decoration: none;
    opacity: 0.6;
    transition: opacity 0.15s;
  }

  .vice-link a:hover {
    opacity: 1;
  }

  .zadne-akce-hero {
    padding: 2rem;
    text-align: center;
    opacity: 0.7;
  }

  .adresa-socky {
    padding: 2rem 0 4rem;
    border-top: 1px solid color-mix(in srgb, var(--barva-text) 12%, transparent);
  }

  .adresa-socky p {
    font-size: 0.85rem;
    opacity: 0.6;
  }
</style>
