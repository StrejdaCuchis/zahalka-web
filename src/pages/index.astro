---
import { getCollection } from 'astro:content';
import Zaklad from '../layouts/Zaklad.astro';
import KartaAkce from '../components/KartaAkce.astro';
import Blob from '../components/Blob.astro';

const vsechnyAkce = await getCollection('akce');

const siteUrl = import.meta.env.PUBLIC_SITE_URL ?? 'https://zahalka.cz';

const organizationSchema = {
  '@context': 'https://schema.org',
  '@type': 'Organization',
  name: 'Zahálka',
  url: siteUrl,
  address: {
    '@type': 'PostalAddress',
    streetAddress: 'Benešovo nám. 3282',
    addressLocality: 'Teplice',
    postalCode: '415 01',
    addressCountry: 'CZ',
  },
  sameAs: [
    'https://instagram.com/zahalkatesla',
    'https://facebook.com/zahalkatesla',
  ],
};

const dnes = new Date();
dnes.setHours(0, 0, 0, 0);

const nejblizsiAkce = vsechnyAkce
  .filter((a) => a.data.datum >= dnes)
  .sort((a, b) => a.data.datum.getTime() - b.data.datum.getTime())
  .slice(0, 3);
---

<Zaklad
  title="Zahálka – kulturní prostor Teplice"
  description="Zahálka je kulturní prostor v Teplicích pro besedy, workshopy a festivaly. Přijďte na akci — dveře otevíráme pro každého."
  canonicalPath="/"
>
  <Fragment slot="head">
    <script type="application/ld+json" set:html={JSON.stringify(organizationSchema)} />
  </Fragment>

  <main>
    <section class="hero" aria-label="Úvod">
      <!-- Blobs: decorative, aria-hidden, behind content via z-index -->
      <Blob color="levandule" position="top-left"     size={580} opacity={0.84} />
      <Blob color="oranzova"  position="top-right"    size={490} opacity={0.78} />
      <Blob color="fialova"   position="bottom-right" size={540} opacity={0.76} />

      <div class="hero-obsah">
        <h1>Zahálka</h1>
        <p class="hero-podtitul">Kulturní&nbsp;prostor, Teplice</p>
        <p class="hero-text">
          Jsme prostor v centru Teplic, kde se potkávají lidé na besedách, workshopech a festivalech.
          Otvíráme dveře na každou akci — přijďte, jak jste.
        </p>
        <a href="/program" class="btn-cta">Prohlédnout program</a>
      </div>
    </section>

    {nejblizsiAkce.length > 0 && (
      <section class="nejblizsi" aria-label="Nejbližší akce">
        <Blob color="salvej" position="bottom-left" size={380} opacity={0.48} />
        <div class="obal">
          <h2>Nejbližší akce</h2>
          <div class="mrizka">
            {nejblizsiAkce.map((akce) => (
              <KartaAkce entry={akce} />
            ))}
          </div>
          <div class="vice-link">
            <a href="/program">Zobrazit celý program →</a>
          </div>
        </div>
      </section>
    )}

    {nejblizsiAkce.length === 0 && (
      <section class="zadne-akce-hero">
        <p>
          Momentálně neplánujeme nové akce. Sledujte nás na{' '}
          <a href="https://instagram.com/zahalkatesla" target="_blank" rel="noopener">Instagramu</a>.
        </p>
      </section>
    )}

    <section class="adresa-socky" aria-label="Kde nás najdete">
      <div class="obal">
        <p>
          Benešovo nám. 3282, Teplice &nbsp;·&nbsp;
          <a href="https://instagram.com/zahalkatesla" target="_blank" rel="noopener">@zahalkatesla</a>
        </p>
      </div>
    </section>
  </main>
</Zaklad>

<style>
  .hero {
    position: relative;
    overflow: hidden;
    padding: 5rem 2rem 4rem;
    display: flex;
    align-items: center;
    min-height: 55vh;
  }

  .hero-obsah {
    position: relative;
    z-index: 1;
    max-width: 680px;
    margin-inline: auto;
  }

  h1 {
    font-size: clamp(3rem, 8vw, 6rem);
    font-weight: 800;
    letter-spacing: 0.06em;
    line-height: 1;
    margin-bottom: 0.4rem;
  }

  .hero-podtitul {
    font-family: var(--pismo-nadpisy);
    font-size: 0.75rem;
    font-weight: 700;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    opacity: 0.5;
    margin-bottom: 1.75rem;
  }

  .hero-text {
    font-size: 1.1rem;
    line-height: 1.7;
    max-width: 52ch;
    opacity: 0.85;
    margin-bottom: 2rem;
  }

  .btn-cta {
    display: inline-block;
    background-color: var(--barva-text);
    color: var(--barva-pozadi);
    text-decoration: none;
    padding: 0.8rem 2rem;
    border-radius: 100vw;
    font-family: var(--pismo-nadpisy);
    font-size: 0.8rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    transition: background-color 0.15s;
  }

  .btn-cta:hover {
    background-color: var(--barva-text-d);
    color: var(--barva-pozadi);
  }

  .obal {
    position: relative;
    z-index: 1;
    max-width: 1100px;
    margin-inline: auto;
    padding-inline: 2rem;
  }

  .nejblizsi {
    position: relative;
    overflow: hidden;
    padding-block: 2rem 5rem;
  }

  h2 {
    font-size: 0.75rem;
    letter-spacing: 0.14em;
    opacity: 0.5;
    margin-bottom: 1.5rem;
  }

  .mrizka {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(280px, 1fr));
    gap: 1.5rem;
  }

  .vice-link {
    margin-top: 2rem;
    text-align: right;
  }

  .vice-link a {
    font-family: var(--pismo-nadpisy);
    font-size: 0.78rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    text-decoration: none;
    opacity: 0.6;
    transition: opacity 0.15s;
  }

  .vice-link a:hover {
    opacity: 1;
  }

  .zadne-akce-hero {
    padding: 2rem;
    text-align: center;
    opacity: 0.7;
  }

  .adresa-socky {
    padding: 2rem 0 4rem;
    border-top: 1px solid color-mix(in srgb, var(--barva-text) 12%, transparent);
  }

  .adresa-socky p {
    font-size: 0.85rem;
    opacity: 0.6;
  }
</style>
