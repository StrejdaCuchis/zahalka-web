---
import Zaklad from '../layouts/Zaklad.astro';
import { kontakty } from '../data/kontakty';
---

<Zaklad
  pozadi={6}
  title="Děkujeme za přihlášení k newsletteru – Zahálka"
  description="Děkujeme za přihlášení k novinkám Zahálky. Program, nové články a zprávy z kulturního prostoru vám pošleme do e-mailu."
  canonicalPath="/thank-you-newsletter"
  noindex
>
  <main>
    <article>
      <p class="znacka">Zahálka do e-mailu</p>
      <h1>Díky, že jste <span>s námi.</span></h1>
      <p class="potvrzeni">Vaše přihlášení k newsletteru máme uložené.</p>
      <p>
        Jednou za čas vám pošleme nový program, čerstvý článek nebo něco ze zákulisí.
        Těšíme se na viděnou v Zahálce.
      </p>
      <nav aria-label="Kam dál">
        <a class="btn-cta program" href="/program">Prohlédnout program</a>
        <a class="btn-cta" href="/blog">Číst příběhy ze Zahálky</a>
      </nav>
      <p class="odhlaseni">
        Odběr můžete kdykoli zrušit e-mailem na
        <a href={`mailto:${kontakty.email}?subject=Odhl%C3%A1%C5%A1en%C3%AD%20newsletteru`}>{kontakty.email}</a>.
      </p>
    </article>
  </main>
</Zaklad>

<style>
  main {
    position: relative;
    padding: clamp(3rem, 8vw, 6rem) 1.25rem;
  }

  article {
    position: relative;
    z-index: 1;
    max-width: 48rem;
    margin-inline: auto;
    padding: clamp(1.5rem, 5vw, 3.5rem);
    border-radius: 1.25rem;
    background: var(--barva-pozadi);
  }

  .znacka {
    margin-bottom: 1rem;
    font-family: var(--pismo-nadpisy);
    font-size: 0.75rem;
    font-weight: 600;
    letter-spacing: 0.1em;
    text-transform: uppercase;
  }

  h1 {
    margin-bottom: 1.5rem;
    font-size: clamp(2rem, 5vw, 3.5rem);
  }

  h1 span {
    white-space: nowrap;
  }

  p {
    max-width: 58ch;
    line-height: 1.7;
  }

  .potvrzeni {
    margin-bottom: 0.6rem;
    font-size: 1.15rem;
    font-weight: 600;
  }

  nav {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    margin-block: 2rem;
  }

  .btn-cta {
    padding: 0.8rem 1.3rem;
    border: 1.5px solid var(--barva-text);
    border-radius: 999px;
    background: var(--barva-pozadi);
    color: var(--barva-text);
    text-decoration: none;
  }

  .btn-cta:hover {
    background: color-mix(in srgb, var(--salvej) 18%, var(--barva-pozadi));
  }

  .program {
    background: var(--barva-text);
    color: var(--barva-pozadi);
  }

  .program:hover {
    background: var(--barva-text-d);
  }

  .odhlaseni {
    font-size: 0.8rem;
  }

  .odhlaseni a {
    overflow-wrap: anywhere;
  }
</style>
