---
import { getCollection, render } from 'astro:content';
import Zaklad from '../layouts/Zaklad.astro';
import Blob from '../components/Blob.astro';

const [oNas] = await getCollection('oNas');

if (!oNas) {
  throw new Error('Chybí obsah stránky O nás v src/content/stranky/o-nas.md');
}

const { Content } = await render(oNas);
const { nazev, metaPopis, perex, fotky = [] } = oNas.data;
const ogImage = fotky.at(0)?.obrazek;
---

<Zaklad
  title={`${nazev} – Zahálka`}
  description={metaPopis}
  ogImage={ogImage}
  canonicalPath="/o-nas"
>
  <main>
    <Blob color="oranzova" position="top-left" size={420} opacity={0.58} />
    <Blob color="salvej" position="bottom-right" size={360} opacity={0.48} />

    <article>
      <header class="uvod">
        <h1>{nazev}</h1>
        <p class="perex">{perex}</p>
      </header>

      <section class="obsah" aria-label="Příběh Zahálky">
        <Content />
      </section>

      {fotky.length > 0 && (
        <section class="fotogalerie" aria-labelledby="fotogalerie-o-nas">
          <h2 id="fotogalerie-o-nas">Fotogalerie</h2>
          <ul>
            {fotky.map((fotka) => (
              <li>
                <figure>
                  <img
                    src={fotka.obrazek}
                    alt={fotka.altText}
                    width="1200"
                    height="800"
                    loading="lazy"
                  />
                  {fotka.popisek && <figcaption>{fotka.popisek}</figcaption>}
                </figure>
              </li>
            ))}
          </ul>
        </section>
      )}
    </article>
  </main>
</Zaklad>

<style>
  main {
    position: relative;
    overflow: hidden;
    padding-block: 3rem 5rem;
  }

  article {
    position: relative;
    z-index: 1;
    max-width: 72ch;
    margin-inline: auto;
    padding-inline: 2rem;
  }

  .uvod {
    margin-bottom: 3rem;
  }

  h1 {
    font-size: clamp(2rem, 5vw, 3.5rem);
    margin-bottom: 1rem;
  }

  .perex {
    font-size: 1.15rem;
    line-height: 1.65;
    max-width: 58ch;
    opacity: 0.85;
  }

  .obsah :global(h2) {
    font-size: 1.1rem;
    margin: 3.5rem 0 1rem;
  }

  .obsah :global(h2:first-child) {
    margin-top: 0;
  }

  .obsah :global(p) {
    margin-bottom: 1rem;
    line-height: 1.7;
  }

  .obsah :global(a) {
    text-decoration: underline;
    text-underline-offset: 3px;
  }

  .fotogalerie {
    margin-top: 4rem;
  }

  .fotogalerie h2 {
    font-size: 1.1rem;
    margin-bottom: 1rem;
  }

  .fotogalerie ul {
    list-style: none;
    display: grid;
    gap: 1.5rem;
  }

  figure {
    border-radius: 0.75rem;
    overflow: hidden;
    background-color: color-mix(in srgb, var(--barva-text) 8%, var(--barva-pozadi));
  }

  figure img {
    width: 100%;
    height: auto;
    aspect-ratio: 3 / 2;
    object-fit: cover;
    display: block;
  }

  figcaption {
    font-size: 0.85rem;
    font-style: italic;
    opacity: 0.65;
    padding: 0.5rem 0.75rem;
  }
</style>
