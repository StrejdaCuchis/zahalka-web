---
import { getCollection, render } from 'astro:content';
import Zaklad from '../layouts/Zaklad.astro';
import MobilniKompozice from '../components/MobilniKompozice.astro';
import ObsahSKompozici from '../components/ObsahSKompozici.astro';
import { kontakty } from '../data/kontakty';
import { ceskaTypografie } from '../utils/typografie';

const [oNas] = await getCollection('oNas');

if (!oNas) {
  throw new Error('Chybí obsah stránky O nás v src/content/stranky/o-nas.md');
}

const { Content } = await render(oNas);
const { nazev, metaPopis, perex } = oNas.data;
const ogImage = '/obrazky/stranky/o-nas-01.webp';
const ogImageAlt = 'Skupina účastníků na komentované procházce v parku v Teplicích';
---

<Zaklad
  pozadi={5}
  title="O nás – Zahálka • kulturní prostor"
  description={metaPopis}
  ogImage={ogImage}
  ogImageAlt={ogImageAlt}
  canonicalPath="/o-nas"
>
  <main>

    <article>
      <header class="uvod">
        <h1>{ceskaTypografie(nazev)}</h1>
        {perex && <p class="perex">{ceskaTypografie(perex)}</p>}
      </header>

      <MobilniKompozice varianta={5} cast="horni" />

      <section class="obsah" aria-label="Příběh Zahálky">
        <ObsahSKompozici varianta={5}><Content /></ObsahSKompozici>
      </section>

      <nav class="souvisejici" aria-label="Související odkazy">
        <a href="/program">Prohlédnout program</a>
        <a href="/kontakt">Kontakt</a>
        <a href={`mailto:${kontakty.email}`}>{kontakty.email}</a>
      </nav>
      <MobilniKompozice varianta={5} cast="dolni" />
    </article>
  </main>
</Zaklad>

<style>
  main {
    position: relative;
    overflow: hidden;
    padding-block: 3rem 5rem;
  }

  article {
    position: relative;
    z-index: 1;
    max-width: 1100px;
    margin-inline: auto;
    padding-inline: 2rem;
  }

  .uvod {
    max-width: 72ch;
    margin-inline: auto;
    margin-bottom: 3rem;
  }

  h1 {
    font-size: clamp(2rem, 5vw, 3.5rem);
    margin-bottom: 1rem;
  }

  .perex {
    font-size: 1.15rem;
    line-height: 1.65;
    max-width: 58ch;
  }

  .obsah :global(h2) {
    max-width: 72ch;
    margin-inline: auto;
    font-size: 1.1rem;
    margin-top: 3.5rem;
    margin-bottom: 1rem;
  }

  .obsah :global(h2:first-child) {
    margin-top: 0;
  }

  .obsah :global(p) {
    max-width: 72ch;
    margin-inline: auto;
    margin-bottom: 1rem;
    line-height: 1.7;
  }

  .obsah :global(a) {
    text-decoration: underline;
    text-underline-offset: 3px;
  }

  .obsah :global(.foto-skupina) {
    display: grid;
    gap: 1rem;
    width: 100%;
    margin-block: 2.5rem 1rem;
  }

  .obsah :global(.foto-skupina[data-pocet='2']) {
    grid-template-columns: repeat(2, minmax(0, 1fr));
  }

  .obsah :global(.foto-skupina[data-pocet='3']) {
    grid-template-columns: repeat(3, minmax(0, 1fr));
  }

  .obsah :global(.foto-skupina[data-pocet='1']) {
    max-width: 900px;
    margin-inline: auto;
  }

  .obsah :global(.foto-v-clanku) {
    border-radius: 0.75rem;
    overflow: hidden;
    background-color: color-mix(in srgb, var(--barva-text) 8%, var(--barva-pozadi));
  }

  .obsah :global(.foto-v-clanku img) {
    width: 100%;
    height: auto;
    display: block;
  }

  .souvisejici {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 0.75rem 1.5rem;
    max-width: 72ch;
    margin: 3rem auto 0;
    padding-top: 2rem;
    border-top: 1px solid color-mix(in srgb, var(--barva-text) 15%, transparent);
  }

  .souvisejici a {
    font-family: var(--pismo-nadpisy);
    font-size: 0.78rem;
    font-weight: 600;
    letter-spacing: 0.06em;
    text-transform: uppercase;
  }

  @media (max-width: 700px) {
    .obsah :global(.foto-skupina[data-pocet]) {
      grid-template-columns: 1fr;
    }
  }
</style>
