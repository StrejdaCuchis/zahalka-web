---
interface Props {
  galerieId: string;
}

const { galerieId } = Astro.props;
---

<dialog
  id={`prohlizec-${galerieId}`}
  class="prohlizec"
  data-prohlizec
  data-galerie-id={galerieId}
  aria-label="Prohlížeč fotografií"
>
  <p class="poradi" data-poradi role="status" aria-live="polite" aria-atomic="true"></p>
  <form method="dialog" class="zavirani">
    <button class="zavrit" aria-label="Zavřít prohlížeč fotografií" autofocus>
      <span>Zavřít</span><span aria-hidden="true">×</span>
    </button>
  </form>
  <button type="button" class="predchozi sipka" data-predchozi aria-label="Předchozí fotografie">
    <span aria-hidden="true">←</span>
  </button>
  <figure class="fotografie">
    <img data-obrazek alt="" />
    <figcaption data-popisek></figcaption>
    <p data-chyba role="alert" hidden>Fotografii se nepodařilo načíst. Zkuste jiný snímek nebo prohlížeč zavřete.</p>
  </figure>
  <button type="button" class="dalsi sipka" data-dalsi aria-label="Další fotografie">
    <span aria-hidden="true">→</span>
  </button>
</dialog>

<script>
  for (const dialog of document.querySelectorAll<HTMLDialogElement>('[data-prohlizec]')) {
    // Bez podpory dialogu i bez JS dál fungují odkazy přímo na obrázky.
    if (typeof dialog.showModal !== 'function') continue;

    const galerie = document.getElementById(dialog.dataset.galerieId ?? '')?.closest('section');
    const odkazy = Array.from(galerie?.querySelectorAll<HTMLAnchorElement>('a[data-fotka]') ?? []);
    const obrazek = dialog.querySelector<HTMLImageElement>('[data-obrazek]')!;
    const popisek = dialog.querySelector<HTMLElement>('[data-popisek]')!;
    const poradi = dialog.querySelector<HTMLElement>('[data-poradi]')!;
    const chyba = dialog.querySelector<HTMLElement>('[data-chyba]')!;
    const zavrit = dialog.querySelector<HTMLButtonElement>('.zavrit')!;
    const predchozi = dialog.querySelector<HTMLButtonElement>('[data-predchozi]')!;
    const dalsi = dialog.querySelector<HTMLButtonElement>('[data-dalsi]')!;
    const fotky = odkazy.map((odkaz) => {
      const nahled = odkaz.querySelector('img')!;
      return {
        src: odkaz.href,
        alt: nahled.alt,
        width: Number(nahled.getAttribute('width')) || nahled.naturalWidth,
        height: Number(nahled.getAttribute('height')) || nahled.naturalHeight,
        popisek: odkaz.closest('figure')?.querySelector('figcaption')?.textContent ?? nahled.alt,
      };
    });
    let index = 0;
    let spoustec: HTMLButtonElement | undefined;
    let stiskMimo = false;

    function zobrazit(novyIndex: number) {
      index = (novyIndex + fotky.length) % fotky.length;
      const fotka = fotky[index];
      chyba.hidden = true;
      obrazek.hidden = false;
      obrazek.alt = fotka.alt;
      obrazek.width = fotka.width;
      obrazek.height = fotka.height;
      obrazek.src = fotka.src;
      popisek.textContent = fotka.popisek;
      poradi.textContent = `Fotografie ${index + 1} z ${fotky.length}`;
    }

    obrazek.addEventListener('error', () => {
      obrazek.hidden = true;
      chyba.hidden = false;
    });
    predchozi.hidden = dalsi.hidden = fotky.length < 2;
    predchozi.addEventListener('click', () => zobrazit(index - 1));
    dalsi.addEventListener('click', () => zobrazit(index + 1));
    dialog.addEventListener('keydown', (event) => {
      if (event.altKey || event.ctrlKey || event.metaKey) return;
      if (event.key === 'ArrowLeft' || event.key === 'ArrowRight') {
        event.preventDefault();
        zobrazit(index + (event.key === 'ArrowLeft' ? -1 : 1));
      }
      // Escape, modalitu i pohyb Tabem zajišťuje nativní dialog.
    });
    dialog.addEventListener('pointerdown', (event) => {
      stiskMimo = event.target === dialog;
    });
    dialog.addEventListener('pointercancel', () => { stiskMimo = false; });
    dialog.addEventListener('click', (event) => {
      // Přetažení z obrázku na pozadí nemá fotografii nechtěně zavřít.
      if (stiskMimo && event.target === dialog) dialog.close();
      stiskMimo = false;
    });
    dialog.addEventListener('close', () => {
      document.documentElement.classList.remove('prohlizec-otevren');
      spoustec?.focus({ preventScroll: true });
    });

    odkazy.forEach((odkaz, cislo) => {
      // Po aktivaci JS je spouštěč akcí, proto dostane sémantiku tlačítka.
      const tlacitko = document.createElement('button');
      tlacitko.type = 'button';
      tlacitko.className = 'foto-spoustec';
      tlacitko.setAttribute('aria-label', `Zvětšit fotografii: ${fotky[cislo].alt}`);
      tlacitko.setAttribute('aria-haspopup', 'dialog');
      tlacitko.setAttribute('aria-controls', dialog.id);
      tlacitko.append(...odkaz.childNodes);
      tlacitko.addEventListener('click', () => {
        spoustec = tlacitko;
        zobrazit(cislo);
        dialog.showModal();
        document.documentElement.classList.add('prohlizec-otevren');
        zavrit.focus({ preventScroll: true });
      });
      odkaz.replaceWith(tlacitko);
    });
  }
</script>

<style>
  :global(html:has([data-prohlizec])) {
    scrollbar-gutter: stable;
  }

  :global(html.prohlizec-otevren) {
    overflow: hidden;
  }

  .prohlizec {
    position: fixed;
    inset: 0;
    width: 100%;
    max-width: none;
    height: 100dvh;
    max-height: none;
    margin: 0;
    padding: max(1rem, env(safe-area-inset-top)) max(1rem, env(safe-area-inset-right)) max(1rem, env(safe-area-inset-bottom)) max(1rem, env(safe-area-inset-left));
    border: 0;
    background: transparent;
    color: var(--barva-pozadi);
    overscroll-behavior: contain;
  }

  .prohlizec:not([open]),
  .prohlizec [hidden] {
    display: none;
  }

  .prohlizec[open] {
    display: grid;
    grid-template-columns: 3rem minmax(0, 1fr) 3rem;
    grid-template-rows: auto minmax(0, 1fr);
    align-items: center;
    gap: 1rem;
  }

  .prohlizec::backdrop {
    background: rgb(12 28 22 / 94%);
  }

  .poradi {
    grid-column: 1 / 3;
    grid-row: 1;
    font-size: 0.9rem;
    pointer-events: none;
  }

  .zavirani {
    grid-column: 2 / 4;
    grid-row: 1;
    justify-self: end;
  }

  button {
    display: flex;
    align-items: center;
    justify-content: center;
    min-width: 48px;
    min-height: 48px;
    padding: 0.5rem;
    border: 1px solid var(--barva-pozadi);
    border-radius: 100vw;
    background: var(--barva-pozadi);
    color: var(--barva-text-d);
    font: inherit;
    cursor: pointer;
  }

  button:hover {
    background: #fff;
  }

  button:focus-visible {
    outline: 3px solid var(--barva-pozadi);
    outline-offset: 4px;
  }

  .zavrit {
    gap: 0.75rem;
    padding-inline: 1rem;
  }

  .zavrit span:last-child,
  .sipka {
    font-size: 1.75rem;
    line-height: 1;
  }

  .predchozi {
    grid-column: 1;
    grid-row: 2;
  }

  .dalsi {
    grid-column: 3;
    grid-row: 2;
  }

  .fotografie {
    grid-column: 2;
    grid-row: 2;
    justify-self: center;
    width: fit-content;
    max-width: 100%;
    margin: 0;
  }

  .fotografie img {
    width: auto;
    height: auto;
    max-width: 100%;
    max-height: calc(100dvh - 12rem);
    object-fit: contain;
    margin-inline: auto;
    border-radius: var(--polomer-fotek);
  }

  figcaption,
  [data-chyba] {
    max-width: 75ch;
    margin: 0.75rem auto 0;
    color: var(--barva-pozadi);
    font-size: 0.9rem;
    line-height: 1.5;
    text-align: center;
  }

  @media (max-width: 600px) {
    .prohlizec[open] {
      grid-template-columns: 1fr 1fr;
      grid-template-rows: auto minmax(0, 1fr) auto;
    }

    .poradi {
      grid-column: 1;
    }

    .zavirani {
      grid-column: 2;
    }

    .fotografie {
      grid-column: 1 / -1;
    }

    .predchozi,
    .dalsi {
      grid-row: 3;
      justify-self: center;
    }

    .dalsi {
      grid-column: 2;
    }

    .fotografie img {
      max-height: calc(100dvh - 16rem);
    }
  }
</style>
