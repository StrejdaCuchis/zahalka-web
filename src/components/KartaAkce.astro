---
import type { CollectionEntry } from 'astro:content';
import { rozmeryVerejnehoObrazku } from '../utils/obrazky';
import { ceskaTypografie } from '../utils/typografie';
import StitkyAkce from './StitkyAkce.astro';

interface Props {
  entry: CollectionEntry<'akce'>;
}

const { entry } = Astro.props;
const { nazev, datum, cas, typ, obrazek, altText, kratkyPopis, misto } = entry.data;

const moznostMisto = misto ?? 'Benešovo nám. 3282, Teplice';
const rozmery = await rozmeryVerejnehoObrazku(obrazek);
const datumISO = datum.toISOString().split('T')[0];
const datumFormatovany = datum.toLocaleDateString('cs-CZ', {
  day:   'numeric',
  month: 'long',
  year:  'numeric',
});
---

<article class="karta" data-typ={typ.join(' ')}>
  <a href={`/akce/${entry.id}`} class="karta-odkaz">
    <figure class="karta-obrazek">
      <img
        src={obrazek}
        alt={altText}
        width={rozmery.width}
        height={rozmery.height}
        loading="lazy"
      />
    </figure>

    <div class="karta-telo">
      <StitkyAkce typy={typ} />

      <h3 class="karta-nazev">{ceskaTypografie(nazev)}</h3>

      <time class="karta-datum" datetime={`${datumISO}T${cas}:00`}>
        {datumFormatovany}, {cas}
      </time>

      <p class="karta-misto">{ceskaTypografie(moznostMisto)}</p>

      <p class="karta-popis">{ceskaTypografie(kratkyPopis)}</p>
    </div>
  </a>
</article>

<style>
  .karta {
    background-color: color-mix(in srgb, var(--barva-pozadi) 60%, white);
    border-radius: var(--polomer-fotek);
    overflow: hidden;
    position: relative;
    transition: transform 0.2s, box-shadow 0.2s;
  }

  .karta:hover {
    transform: translateY(-3px);
    box-shadow: 0 8px 24px color-mix(in srgb, var(--barva-text) 12%, transparent);
  }

  .karta-odkaz {
    display: flex;
    flex-direction: column;
    height: 100%;
    text-decoration: none;
    color: inherit;
  }

  .karta-odkaz::after {
    content: '';
    position: absolute;
    inset: 0;
  }

  .karta-obrazek {
    margin: 0;
    flex: none;
    overflow: hidden;
    border-radius: var(--polomer-fotek);
    background-color: var(--barva-pozadi);
  }

  .karta-obrazek img {
    display: block;
    width: 100%;
    height: auto;
  }

  .karta-telo {
    padding: 1.25rem 1.25rem 1.5rem;
    display: flex;
    flex-direction: column;
    gap: 0.4rem;
    flex: 1;
  }

  .karta-nazev {
    font-size: 1.05rem;
    font-weight: 800;
    margin-top: 0.2rem;
    color: var(--barva-text-d);
  }

  .karta-datum {
    font-size: 0.85rem;
    font-weight: 500;
    opacity: 0.8;
  }

  .karta-misto {
    font-size: 0.8rem;
    opacity: 0.65;
  }

  .karta-popis {
    font-size: 0.875rem;
    line-height: 1.5;
    opacity: 0.85;
    margin-top: 0.4rem;
  }
</style>
