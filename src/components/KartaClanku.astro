---
import type { CollectionEntry } from 'astro:content';

interface Props {
  entry: CollectionEntry<'blog'>;
  urovenNadpisu?: 2 | 3;
}

const { entry, urovenNadpisu = 2 } = Astro.props;
const { nazev, datumPublikace, obrazek, altText, kratkyPopis, stitky } = entry.data;
const Nadpis = `h${urovenNadpisu}` as 'h2' | 'h3';
const datumISO = datumPublikace.toISOString().split('T')[0];
const datumFormatovany = datumPublikace.toLocaleDateString('cs-CZ', {
  day: 'numeric',
  month: 'long',
  year: 'numeric',
});
---

<article class="karta-clanku">
  <a href={`/blog/${entry.id}`}>
    <figure>
      <img src={obrazek} alt={altText} width="600" height="400" loading="lazy" />
    </figure>
    <header>
      {stitky[0] && <p class="stitek">{stitky[0]}</p>}
      <Nadpis>{nazev}</Nadpis>
      <time datetime={datumISO}>{datumFormatovany}</time>
      <p class="popis">{kratkyPopis}</p>
      <span class="vice" aria-hidden="true">Číst článek →</span>
    </header>
  </a>
</article>

<style>
  .karta-clanku {
    position: relative;
    overflow: hidden;
    border-radius: 1rem;
    background: color-mix(in srgb, var(--barva-pozadi) 60%, white);
    transition: transform 0.2s, box-shadow 0.2s;
  }

  .karta-clanku:hover {
    transform: translateY(-3px);
    box-shadow: 0 8px 24px color-mix(in srgb, var(--barva-text) 12%, transparent);
  }

  a {
    display: flex;
    flex-direction: column;
    height: 100%;
    color: inherit;
    text-decoration: none;
  }

  a::after {
    content: '';
    position: absolute;
    inset: 0;
  }

  figure {
    aspect-ratio: 3 / 2;
    overflow: hidden;
    background: color-mix(in srgb, var(--barva-text) 8%, var(--barva-pozadi));
  }

  img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.3s;
  }

  .karta-clanku:hover img {
    transform: scale(1.03);
  }

  header {
    display: flex;
    flex: 1;
    flex-direction: column;
    align-items: flex-start;
    padding: 1.25rem 1.25rem 1.5rem;
  }

  .stitek {
    margin-bottom: 0.55rem;
    padding: 0.2rem 0.65rem;
    border-radius: 100vw;
    background: var(--levandule-l);
    font-family: var(--pismo-nadpisy);
    font-size: 0.65rem;
    font-weight: 600;
    letter-spacing: 0.1em;
    text-transform: uppercase;
  }

  h2,
  h3 {
    margin-bottom: 0.45rem;
    font-size: 1.08rem;
  }

  time {
    font-size: 0.8rem;
    opacity: 0.65;
  }

  .popis {
    margin-top: 0.75rem;
    font-size: 0.9rem;
    line-height: 1.55;
    opacity: 0.85;
  }

  .vice {
    margin-top: auto;
    padding-top: 1rem;
    font-family: var(--pismo-nadpisy);
    font-size: 0.72rem;
    font-weight: 600;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }
</style>
