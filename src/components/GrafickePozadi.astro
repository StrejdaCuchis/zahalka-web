---
/** Autorské kompozice mají vlastní mobilní export; nikdy je neskládáme znovu v CSS. */
interface Props {
  varianta: 1 | 2 | 3 | 4 | 5 | 6;
  samostatne?: boolean;
  lazy?: boolean;
}

const { varianta, samostatne = false, lazy = false } = Astro.props;
const cesta = `/obrazky/pozadi/varianta-${varianta}`;
---

<picture class:list={['graficke-pozadi', { samostatne }]} aria-hidden="true">
  <source media="(max-width: 700px)" srcset={`${cesta}-mobil.webp`} width="720" height="1280" />
  <img
    src={`${cesta}-desktop.webp`}
    alt=""
    width="1920"
    height="1080"
    loading={lazy ? 'lazy' : 'eager'}
    decoding="async"
  />
</picture>

<style>
  .graficke-pozadi {
    position: absolute;
    inset: 0 0 auto;
    z-index: 0;
    display: block;
    height: clamp(32rem, 56.25vw, 54rem);
    max-height: 100%;
    pointer-events: none;
    user-select: none;
    /* Krémový podklad zůstává dominantní; syté originály jsou v dokumentaci. */
    opacity: 0.24;
  }

  img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center;
  }

  /* Samostatná dekorace rezervuje místo a nikdy neleží pod textem. */
  .samostatne {
    position: relative;
    inset: auto;
    height: auto;
    max-height: none;
    opacity: 1;
  }

  .samostatne img {
    height: auto;
  }

  @media (max-width: 700px) {
    .graficke-pozadi:not(.samostatne) {
      height: clamp(36rem, 177.78vw, 48rem);
    }
  }
</style>
