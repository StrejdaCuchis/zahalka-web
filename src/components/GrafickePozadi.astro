---
/** Samostatná kompozice s úplnými tvary; rezervuje původní rozměry ilustrace. */
import PozadiStranky from './PozadiStranky.astro';
interface Props {
  varianta: 1 | 2 | 3 | 4 | 5 | 6;
  samostatne?: boolean;
  lazy?: boolean;
}

const { varianta, samostatne = false, lazy = false } = Astro.props;
---

<div
  class:list={['graficke-pozadi', { samostatne }]}
  aria-hidden="true"
>
  <PozadiStranky varianta={varianta} lazy={lazy} />
</div>

<style>
  .graficke-pozadi {
    position: relative;
    isolation: isolate;
    display: block;
    aspect-ratio: 16 / 9;
    pointer-events: none;
    user-select: none;
  }

  @media (max-width: 700px) {
    .graficke-pozadi {
      aspect-ratio: 9 / 16;
    }
  }
</style>
