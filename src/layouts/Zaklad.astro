---
import '../styly/global.css';
import Analytika from '../components/Analytika.astro';

interface Props {
  title: string;
  description: string;
  ogImage?: string;
  ogType?: string;
  canonicalPath: string;
}

const {
  title,
  description,
  ogImage,
  ogType = 'website',
  canonicalPath,
} = Astro.props;

const siteUrl = import.meta.env.PUBLIC_SITE_URL ?? 'https://zahalka.cz';
const canonicalUrl = `${siteUrl}${canonicalPath}`;
const ogImageUrl = ogImage
  ? `${siteUrl}${ogImage}`
  : `${siteUrl}/og-default.png`;
---

<!doctype html>
<html lang="cs">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" href="/favicon.ico" />

    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalUrl} />

    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImageUrl} />
    <meta property="og:type" content={ogType} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:locale" content="cs_CZ" />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageUrl} />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;700&family=Manrope:wght@600;700;800&display=swap"
      rel="stylesheet"
    />

    <slot name="head" />
  </head>
  <body>
    <header>
      <a href="/" class="logo" aria-label="Zahálka – domovská stránka">
        <span class="logo-nazev">ZAHÁLKA</span>
        <span class="logo-podtitul">KULTURNÍ&nbsp;PROSTOR</span>
      </a>

      <nav aria-label="Hlavní navigace">
        <a href="/">Domů</a>
        <a href="/program">Program</a>
        <a href="/tabor">Tábor</a>
        <a href="/o-nas">O nás</a>
        <a href="/kontakt">Kontakt</a>
      </nav>
    </header>

    <slot />

    <Analytika />

    <footer>
      <div class="paticka-obsah">
        <p class="paticka-nazev">Zahálka – kulturní prostor</p>
        <address>Benešovo nám. 3282, 415 01 Teplice</address>
        <nav aria-label="Sociální sítě">
          <a href="https://www.instagram.com/zahalkateplice/" target="_blank" rel="noopener">Instagram</a>
          <a href="https://www.facebook.com/zahalkateplice" target="_blank" rel="noopener">Facebook</a>
        </nav>
      </div>
    </footer>
  </body>
</html>

<style>
  header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 1.25rem 2rem;
    border-bottom: 1px solid color-mix(in srgb, var(--barva-text) 15%, transparent);
  }

  nav a {
    font-family: var(--pismo-nadpisy);
    font-size: 0.8rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    text-decoration: none;
    margin-right: 1.5rem;
    opacity: 0.75;
    transition: opacity 0.15s;
  }

  nav a:hover,
  nav a:focus-visible {
    opacity: 1;
  }

  .logo {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    text-decoration: none;
    line-height: 1.1;
  }

  .logo-nazev {
    font-family: var(--pismo-nadpisy);
    font-size: 1.1rem;
    font-weight: 800;
    letter-spacing: 0.1em;
    color: var(--barva-text-d);
  }

  .logo-podtitul {
    font-family: var(--pismo-nadpisy);
    font-size: 0.6rem;
    font-weight: 700;
    letter-spacing: 0.12em;
    color: var(--barva-text);
    opacity: 0.7;
  }

  footer {
    margin-top: auto;
    border-top: 1px solid color-mix(in srgb, var(--barva-text) 15%, transparent);
    padding: 2rem;
  }

  .paticka-obsah {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem 2rem;
    align-items: baseline;
    font-size: 0.875rem;
  }

  .paticka-nazev {
    font-family: var(--pismo-nadpisy);
    font-weight: 700;
    font-size: 0.75rem;
    text-transform: uppercase;
    letter-spacing: 0.08em;
  }

  address {
    font-style: normal;
    opacity: 0.75;
  }

  footer nav {
    margin-left: auto;
  }

  footer nav a {
    font-family: var(--pismo-nadpisy);
    font-size: 0.75rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    text-decoration: none;
    margin-right: 1rem;
    opacity: 0.75;
    transition: opacity 0.15s;
  }

  footer nav a:hover {
    opacity: 1;
  }

  @media (max-width: 600px) {
    header {
      padding: 1rem;
    }

    header nav a {
      margin-right: 0.75rem;
      font-size: 0.7rem;
    }

    footer nav {
      margin-left: 0;
    }
  }
</style>
