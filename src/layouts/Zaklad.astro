---
import '../styly/global.css';
import Analytika from '../components/Analytika.astro';

interface Props {
  title: string;
  description: string;
  ogImage?: string;
  ogImageAlt?: string;
  ogType?: string;
  canonicalPath: string;
  noindex?: boolean;
}

const {
  title,
  description,
  ogImage,
  ogImageAlt = 'Zahálka – kulturní prostor v Teplicích',
  ogType = 'website',
  canonicalPath,
  noindex = false,
} = Astro.props;

const siteUrl = import.meta.env.PUBLIC_SITE_URL ?? 'https://zahalka.cz';
const canonicalUrl = `${siteUrl}${canonicalPath}`;
const ogImageUrl = ogImage
  ? `${siteUrl}${ogImage}`
  : `${siteUrl}/og-default.png`;
const pouzivaVychoziOg = !ogImage;
---

<!doctype html>
<html lang="cs">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-zahalka-32.png" />
    <link rel="icon" type="image/png" sizes="192x192" href="/favicon-zahalka-192.png" />
    <link rel="icon" type="image/x-icon" href="/favicon-zahalka.ico" />
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />

    <title>{title}</title>
    <meta name="description" content={description} />
    {noindex && <meta name="robots" content="noindex, nofollow" />}
    <link rel="canonical" href={canonicalUrl} />

    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImageUrl} />
    <meta property="og:image:alt" content={ogImageAlt} />
    {pouzivaVychoziOg && <meta property="og:image:width" content="1200" />}
    {pouzivaVychoziOg && <meta property="og:image:height" content="630" />}
    <meta property="og:type" content={ogType} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:locale" content="cs_CZ" />
    <meta property="og:site_name" content="Zahálka" />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageUrl} />
    <meta name="twitter:image:alt" content={ogImageAlt} />

    <slot name="head" />
    <!-- JS-mode flag: set before first paint to prevent mobile nav flash -->
    <script>document.documentElement.classList.add('js');</script>
  </head>
  <body>
    <header>
      <a href="/" class="logo" aria-label="Zahálka – domovská stránka">
        <img src="/zahalka-logo.svg" alt="Zahálka kulturní prostor" class="logo-img" width="88" height="50" />
      </a>

      <!-- Hidden until JS activates; without JS the nav stays always visible -->
      <button class="hamburger" aria-label="Menu" aria-expanded="false" aria-controls="hlavni-nav" hidden>
        <svg width="22" height="22" viewBox="0 0 22 22" xmlns="http://www.w3.org/2000/svg" aria-hidden="true" focusable="false" fill="currentColor">
          <g class="hbg-lines">
            <rect x="0" y="2.75"  width="22" height="2.5" rx="1.25"/>
            <rect x="0" y="9.75"  width="22" height="2.5" rx="1.25"/>
            <rect x="0" y="16.75" width="22" height="2.5" rx="1.25"/>
          </g>
          <g class="hbg-close" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" fill="none">
            <line x1="3" y1="3" x2="19" y2="19"/>
            <line x1="19" y1="3" x2="3" y2="19"/>
          </g>
        </svg>
      </button>

      <nav id="hlavni-nav" aria-label="Hlavní navigace">
        <a href="/">Domů</a>
        <a href="/program">Program</a>
        <a href="/tabor">Tábor</a>
        <a href="/o-nas">O nás</a>
        <a href="/kontakt">Kontakt</a>
      </nav>
    </header>

    <slot />

    <Analytika />

    <script is:inline>
      (function () {
        var btn = document.querySelector('.hamburger');
        var nav = document.getElementById('hlavni-nav');
        if (!btn || !nav) return;
        var hdr = btn.closest('header');

        btn.removeAttribute('hidden');

        function openNav() {
          hdr.classList.add('nav-open');
          btn.setAttribute('aria-expanded', 'true');
        }
        function closeNav() {
          hdr.classList.remove('nav-open');
          btn.setAttribute('aria-expanded', 'false');
        }

        btn.addEventListener('click', function () {
          hdr.classList.contains('nav-open') ? closeNav() : openNav();
        });

        nav.querySelectorAll('a').forEach(function (a) {
          a.addEventListener('click', closeNav);
        });

        document.addEventListener('click', function (e) {
          if (hdr.classList.contains('nav-open') && !hdr.contains(e.target)) {
            closeNav();
          }
        });

        document.addEventListener('keydown', function (e) {
          if (e.key === 'Escape' && hdr.classList.contains('nav-open')) {
            closeNav();
            btn.focus();
          }
        });
      })();
    </script>

    <footer>
      <div class="paticka-obsah">
        <p class="paticka-nazev">Zahálka – kulturní prostor</p>
        <address>Benešovo nám. 3282, 415 01 Teplice</address>
        <a href="/cookies" class="paticka-cookies">Cookies</a>
        <nav aria-label="Sociální sítě">
          <a href="https://www.instagram.com/zahalkateplice/" target="_blank" rel="noopener">Instagram</a>
          <a href="https://www.facebook.com/zahalkateplice" target="_blank" rel="noopener">Facebook</a>
        </nav>
      </div>
      <p class="paticka-autor">
        Web vytvořila agentura <a href="https://solveys.cz/">Solveys</a>
      </p>
    </footer>
  </body>
</html>

<style>
  /* ── Header bar ───────────────────────────────────────────────────────── */
  header {
    position: relative;
    z-index: 10;
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 1.25rem 2rem;
    border-bottom: 1px solid color-mix(in srgb, var(--barva-text) 15%, transparent);
    background: var(--barva-pozadi);
  }

  /* ── Logo ─────────────────────────────────────────────────────────────── */
  .logo {
    display: flex;
    text-decoration: none;
    flex-shrink: 0;
  }

  .logo-img {
    height: 44px;
    width: auto;
  }

  /* ── Desktop nav links ────────────────────────────────────────────────── */
  nav a {
    font-family: var(--pismo-nadpisy);
    font-size: 0.8rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    text-decoration: none;
    margin-right: 1.5rem;
    opacity: 0.75;
    transition: opacity 0.15s;
  }

  nav a:hover,
  nav a:focus-visible {
    opacity: 1;
  }

  /* ── Hamburger button (hidden on desktop) ─────────────────────────────── */
  .hamburger {
    display: none;
    align-items: center;
    justify-content: center;
    background: none;
    border: none;
    padding: 0.35rem;
    border-radius: 4px;
    cursor: pointer;
    color: var(--barva-text-d);
    line-height: 0;
  }

  .hamburger:focus-visible {
    outline: 3px solid var(--barva-akcent);
    outline-offset: 2px;
    border-radius: 4px;
  }

  /* Icon swap: hamburger ↔ close */
  .hbg-close { display: none; }
  header.nav-open .hbg-close { display: block; }
  header.nav-open .hbg-lines { display: none; }

  /* ── Footer ───────────────────────────────────────────────────────────── */
  footer {
    margin-top: auto;
    border-top: 1px solid color-mix(in srgb, var(--barva-text) 15%, transparent);
    padding: 2rem;
  }

  .paticka-obsah {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem 2rem;
    align-items: baseline;
    font-size: 0.875rem;
  }

  .paticka-nazev {
    font-family: var(--pismo-nadpisy);
    font-weight: 600;
    font-size: 0.75rem;
    text-transform: uppercase;
    letter-spacing: 0.08em;
  }

  .paticka-autor {
    margin-top: 1.25rem;
    font-size: 0.75rem;
    opacity: 0.6;
  }

  .paticka-autor a {
    color: inherit;
    font-weight: 600;
  }

  .paticka-autor a:hover,
  .paticka-autor a:focus-visible {
    opacity: 0.75;
  }

  address {
    font-style: normal;
    opacity: 0.75;
  }

  .paticka-cookies {
    font-family: var(--pismo-nadpisy);
    font-size: 0.75rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    text-decoration: none;
    opacity: 0.75;
  }

  .paticka-cookies:hover,
  .paticka-cookies:focus-visible {
    opacity: 1;
  }

  footer nav {
    margin-left: auto;
  }

  footer nav a {
    font-family: var(--pismo-nadpisy);
    font-size: 0.75rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    text-decoration: none;
    margin-right: 1rem;
    opacity: 0.75;
    transition: opacity 0.15s;
  }

  footer nav a:hover {
    opacity: 1;
  }

  /* ── Mobile ───────────────────────────────────────────────────────────── */
  @media (max-width: 600px) {
    header {
      padding: 1rem 1.25rem;
    }

    /* Show hamburger button */
    .hamburger {
      display: flex;
    }

    /* Nav panel: drops below the header bar */
    header > nav {
      position: absolute;
      top: 100%;
      left: 0;
      right: 0;
      background: var(--barva-pozadi);
      border-bottom: 1px solid color-mix(in srgb, var(--barva-text) 15%, transparent);
      display: flex;
      flex-direction: column;
      z-index: 100;
    }

    header > nav a {
      margin-right: 0;
      padding: 0.9rem 1.5rem;
      font-size: 0.9rem;
      border-bottom: 1px solid color-mix(in srgb, var(--barva-text) 10%, transparent);
      opacity: 0.85;
    }

    header > nav a:last-child {
      border-bottom: none;
    }

    /* With JS: nav hidden by default; shown only when open */
    html.js header > nav {
      display: none;
    }

    html.js header.nav-open > nav {
      display: flex;
    }

    footer nav {
      margin-left: 0;
    }
  }
</style>
