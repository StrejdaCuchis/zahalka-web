# Copy to .env and fill in real values before deploying.
# All PUBLIC_ variables are safe to expose to the browser.

# Google Analytics 4 — Measurement ID from GA4 admin panel
PUBLIC_GA_ID=G-XXXXXXXXXX

# Microsoft Clarity — Project ID from clarity.microsoft.com
PUBLIC_CLARITY_ID=xxxxxxxxxx

# Canonical site URL — used for OG tags and structured data
PUBLIC_SITE_URL=https://zahalka.cz
